# Free API key from https://finnhub.io/register (no card required).
# Powers live prices for AAPL, TSLA, NVDA, and COIN.
# Copy this file to .env.local and fill in your key, then restart `npm run dev`.
# Bitcoin's live price needs no key (CoinGecko, public endpoint).
VITE_FINNHUB_API_KEY=

# Supabase project (auth + saved portfolios). Free at https://supabase.com.
# Find these under Project Settings -> API. The anon key is safe to expose
# client-side — it's the public key, protected by Row Level Security
# (see supabase/schema.sql). Leave both blank to run in local-only mode
# (no login screen, everything saved to this browser instead).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
